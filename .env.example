# Clé API Resend pour l'envoi des messages du formulaire de contact.
# Créez un compte gratuit sur https://resend.com, récupérez une clé API
# (Dashboard > API Keys) et collez-la ici, dans un fichier .env.local
# (jamais commité) ou dans les variables d'environnement de votre hébergeur.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
